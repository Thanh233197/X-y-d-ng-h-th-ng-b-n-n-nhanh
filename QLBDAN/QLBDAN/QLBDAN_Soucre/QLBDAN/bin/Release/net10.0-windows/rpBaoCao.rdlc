                <TextRun>
                  <Value>TIỆM ĐỒ ĂN NHANH YUMMY "Ngon miệng - Nhanh chóng!" ========================================</Value>
                  <Style>
                    <FontStyle>Normal</FontStyle>
                    <FontFamily>Times New Roman</FontFamily>
